{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TeamBuilderSql": "Server=(localdb)\\mssqllocaldb;Database=TeamBuilder;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AllowedOrigins": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "teambuilder-api",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "Discovery": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
