{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TeamBuilderSql": "Server=(localdb)\\mssqllocaldb;Database=TeamBuilder;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AllowedOrigins": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "teambuilder-api",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "Discovery": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Subscriptions": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 20,
    "LeaseDuration": "00:01:00",
    "MaxAttempts": 5
  }
}
