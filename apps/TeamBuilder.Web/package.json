{
  "name": "teambuilder-web",
  "private": true,
  "version": "0.1.0",
  "description": "Thin responsive private-QA client for the TeamBuilder API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:token": "node scripts/mint-dev-token.mjs"
  },
  "dependencies": {
    "oidc-client-ts": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
