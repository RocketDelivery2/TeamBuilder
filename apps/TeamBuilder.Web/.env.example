# Copy to .env.local (never committed) and fill in. These values are public client settings,
# not secrets: never put a token, client secret or signing key in a VITE_ variable.

# API origin. Leave empty to use the same origin (Vite dev proxy or the nginx /api proxy).
VITE_API_BASE_URL=

# OIDC Authorization Code + PKCE (public SPA client registered at your identity provider).
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile

# Manual bearer-token mode is always available in `npm run dev`. A built bundle only offers it
# when this is explicitly "true" (private QA images only); the UI then shows a warning banner.
VITE_ALLOW_DEV_TOKEN=false
