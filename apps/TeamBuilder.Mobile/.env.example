# Public configuration only. These values are embedded in the app.
EXPO_PUBLIC_ENVIRONMENT=qa
# Include the reverse-proxy prefix if the host strips one (for example /api).
EXPO_PUBLIC_API_BASE_URL=https://qa.example.invalid/api
EXPO_PUBLIC_OIDC_AUTHORITY=https://identity.example.invalid
# Register a native/public client, with no client secret.
EXPO_PUBLIC_OIDC_CLIENT_ID=replace-with-native-client-id
EXPO_PUBLIC_OIDC_SCOPE=openid profile offline_access replace-with-api-scope
# Required for real native push; allocated in your own Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=
