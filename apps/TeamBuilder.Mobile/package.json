    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
