{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teambuilder.example/schemas/tbrl-0.1.schema.json",
  "title": "TeamBuilder Roster Language v0.1",
  "description": "Draft provider-neutral roster interchange format. This schema does not grant authorization to ingest source data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "exportedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "eventSeries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventSeries"
      }
    },
    "eventOccurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventOccurrence"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "localDate": {
      "type": "string",
      "format": "date"
    },
    "localTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA timezone database identifier, for example America/Chicago."
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "id"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Stable identifier for the provider/source namespace; IDs are only unique within this namespace."
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Opaque external identifier. It need not be a TeamBuilder GUID."
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string"
        },
        "permittedUses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "sourceId"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "license": {
          "$ref": "#/$defs/license"
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRef",
        "name"
      ],
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "leagueName": {
          "type": "string"
        },
        "parentRef": {
          "$ref": "#/$defs/externalRef"
        },
        "activityCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "uniqueItems": true
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "taxonomyVersion"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "taxonomyVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          },
          "uniqueItems": true
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "externalLabels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRef",
        "activityCode",
        "name"
      ],
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "organizationRef": {
          "$ref": "#/$defs/externalRef"
        },
        "activityCode": {
          "$ref": "#/$defs/code"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRef"
      ],
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "displayName": {
          "type": "string"
        },
        "activityCode": {
          "$ref": "#/$defs/code"
        },
        "roleCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "uniqueItems": true
        },
        "availability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availability"
          }
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "until": {
          "$ref": "#/$defs/timestamp"
        },
        "activityCode": {
          "$ref": "#/$defs/code"
        },
        "roleCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "uniqueItems": true
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "eventSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRef",
        "activityCode",
        "name",
        "timeZone",
        "localStartDate",
        "localStartTime",
        "durationMinutes",
        "rrule",
        "localEndDate"
      ],
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "teamRef": {
          "$ref": "#/$defs/externalRef"
        },
        "organizationRef": {
          "$ref": "#/$defs/externalRef"
        },
        "activityCode": {
          "$ref": "#/$defs/code"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "localStartDate": {
          "$ref": "#/$defs/localDate"
        },
        "localStartTime": {
          "$ref": "#/$defs/localTime"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "rrule": {
          "type": "string",
          "minLength": 1,
          "pattern": "^FREQ=(DAILY|WEEKLY|MONTHLY|YEARLY)(;|$)",
          "description": "RFC 5545 RRULE value without the RRULE: property prefix."
        },
        "localEndDate": {
          "$ref": "#/$defs/localDate"
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        }
      }
    },
    "rosterRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "quantity"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "roleCode": {
          "$ref": "#/$defs/code"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rosterAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantRef",
        "status"
      ],
      "properties": {
        "participantRef": {
          "$ref": "#/$defs/externalRef"
        },
        "requirementCode": {
          "$ref": "#/$defs/code"
        },
        "roleCode": {
          "$ref": "#/$defs/code"
        },
        "status": {
          "enum": [
            "invited",
            "reserved",
            "confirmed",
            "checkedIn",
            "left",
            "noShow",
            "removed",
            "cancelled"
          ]
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "eventOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRef",
        "activityCode",
        "name",
        "startsAt",
        "endsAt",
        "timeZone",
        "status"
      ],
      "properties": {
        "externalRef": {
          "$ref": "#/$defs/externalRef"
        },
        "seriesRef": {
          "$ref": "#/$defs/externalRef"
        },
        "teamRef": {
          "$ref": "#/$defs/externalRef"
        },
        "organizationRef": {
          "$ref": "#/$defs/externalRef"
        },
        "activityCode": {
          "$ref": "#/$defs/code"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "startsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "status": {
          "enum": [
            "scheduled",
            "inProgress",
            "completed",
            "cancelled"
          ]
        },
        "venue": {
          "$ref": "#/$defs/venue"
        },
        "rosterRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rosterRequirement"
          }
        },
        "rosterAssignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rosterAssignment"
          }
        },
        "sourceUpdatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
