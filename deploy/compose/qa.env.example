# Private-QA release settings for docker-compose.release.yml. Copy to qa.env (git-ignored) and
# fill in. Values marked SECRET belong only in qa.env or your secret store, never in git.
# QA and Production each need their own copy: separate database, OIDC clients, VAPID key pair,
# host name and secrets (docs/qa/private-qa-deployment.md, "Environment separation").

TEAMBUILDER_ENVIRONMENT_SLUG=qa
TEAMBUILDER_ASPNETCORE_ENVIRONMENT=QA
TEAMBUILDER_WEB_ENVIRONMENT=qa

# Public DNS name of the QA site (A/AAAA record pointing at this host; ports 80/443 open).
TEAMBUILDER_SITE_ADDRESS=qa.teambuilder.example

# Images (defaults build locally). Pin released images by tag or digest for repeatable deploys.
# TEAMBUILDER_API_IMAGE=ghcr.io/rocketdelivery2/teambuilder-api:1.0.0
# TEAMBUILDER_WEB_IMAGE=ghcr.io/rocketdelivery2/teambuilder-web:1.0.0
# TEAMBUILDER_MIGRATOR_IMAGE=ghcr.io/rocketdelivery2/teambuilder-migrator:1.0.0
TEAMBUILDER_VERSION=0.0.0-qa
TEAMBUILDER_SOURCE_REVISION=

# SECRET. The QA database only. Encrypt=True; TrustServerCertificate=False for a managed server.
TEAMBUILDER_SQL_CONNECTION_STRING=Server=tcp:<qa-sql-host>,1433;Database=TeamBuilderQA;User Id=<qa-app-user>;Password=<secret>;Encrypt=True;TrustServerCertificate=False
# SECRET. Only with --profile local-sql (then Server=sql;...;TrustServerCertificate=True).
TEAMBUILDER_SQL_SA_PASSWORD=

# OIDC (QA registrations; none of these are secrets).
TEAMBUILDER_OIDC_AUTHORITY=https://<issuer>/
TEAMBUILDER_OIDC_API_AUDIENCE=<api audience, e.g. api://teambuilder-qa>
TEAMBUILDER_OIDC_SPA_CLIENT_ID=<public SPA client id>
TEAMBUILDER_OIDC_SCOPE=openid profile <api scope, e.g. api://teambuilder-qa/access>
# sub for most providers; oid for Microsoft Entra ID access tokens.
TEAMBUILDER_OIDC_SUBJECT_CLAIM=sub
TEAMBUILDER_OIDC_PROVIDER_LABEL=oidc
# Extra origins the browser may call besides the authority (space separated), e.g. a token endpoint on another host.
TEAMBUILDER_CSP_CONNECT_EXTRA=
# Exact https origins, comma separated, only if the web client is served from another origin.
TEAMBUILDER_ALLOWED_ORIGINS=

# Web Push (QA key pair; generate with `docker run --rm <api image> outbox vapid-keys`).
TEAMBUILDER_WEBPUSH_ENABLED=false
TEAMBUILDER_WEBPUSH_SUBJECT=mailto:qa-alerts@teambuilder.example
TEAMBUILDER_VAPID_PUBLIC_KEY=
# SECRET. Server-side only; never in a web build or a committed file.
TEAMBUILDER_VAPID_PRIVATE_KEY=
